# NOTE: data/cache/ must stay tracked. The nightly refresh workflow commits
# snapshots there, and deployments that cannot reach the city APIs (e.g.
# Streamlit Community Cloud behind a WAF) serve real data from those committed
# snapshots. Ignoring it silently breaks the data relay (see tests/test_relay.py).
__pycache__/
*.pyc
*.pyo
.venv/
venv/
.env
*.egg-info/
dist/
build/
.pytest_cache/
.mypy_cache/
